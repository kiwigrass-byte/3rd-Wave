-------- send midi nrpn message ---------------------
-- works more reliably for standard MSB first nrpn messages than the lua API version
function sendNRPN(ch, nrpn, value)
  midi.sendControlChange (port , ch , 99, math.floor(nrpn/128))
  midi.sendControlChange (port , ch , 98, nrpn%128)
  midi.sendControlChange (port , ch , 6, math.floor(value/128))
  midi.sendControlChange (port , ch , 38, value%128)
end

------- send bank/program number changes and request sysEx of loaded patch 
function selectIt(valueObject, value)
  if value==0 then return end
  local message = valueObject:getMessage ()
  local parameterNumber = message:getParameterNumber ()
  local messageValue = message:getValue ()
  local bankNum = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue -1)
  local progNum = parameterMap.get (deviceId, PT_VIRTUAL, parameterNumber-messageValue ) + messageValue - 2
  if progNum == 100 then progNum= 0 end
  if progNum == -1   then progNum=99  end
  parameterMap.set (deviceId, PT_VIRTUAL, parameterNumber-messageValue,progNum)
  midi.sendControlChange(port , channel , 32, bankNum)
  midi.sendProgramChange(port , channel , progNum)
  -- request patch 
  getPatchData(bankNum,progNum)
end

--------------------------- Timer-based program name scanning all patches in all banks ----------------------------------------
-- State tracking for the patch scanner
local patchScanState = {
  bank = 0,           -- current bank (0-4)
  patch = 0,          -- current program (0-99)
  isRunning = false   -- scanner active flag
}

-- Start the patch scanner (sends 5 requests per second)
function startPatchScanner(valueObject,value)
  if value == 0 then return end
  if patchScanState.isRunning then
    print("Program scanner already running")
    return
  end
  patchScanState.isRunning = true
  patchScanState.bank = 0
  patchScanState.patch = 0
  print("Starting program scanner: 5 banks × 100 patches")
  timer.enable()
end

-- function to stop the patch scanner
local function stopPatchScanner()
  timer.disable()
  patchScanState.isRunning = false
  flushNameBankIfDirty()   -- final save at end of scan
  print("Program scanner stopped")
end

local SCAN_HEADER = concat(SYSEX_HEADER,{0x10})

-- Timer callback (called by Electra One runtime)
function timer.onTick()
  if not patchScanState.isRunning then return end
  -- Send the sysex request for current bank/patch
  local msg = concat(SCAN_HEADER, {patchScanState.bank, patchScanState.patch})
  midi.sendSysex(port, msg)
  print(string.format("Requesting Bank %d, Program %03d", patchScanState.bank, patchScanState.patch))
  -- Advance to next patch
  patchScanState.patch = patchScanState.patch + 1
  -- Check if we've reached the end of this bank
  if patchScanState.patch >= 100 then
    patchScanState.patch = 0
    patchScanState.bank = patchScanState.bank + 1
    -- Check if we've completed all 4 banks
    if patchScanState.bank > 4 then
      patchScanState.bank = 0
      print("Program scanner cycle complete")
      stopPatchScanner()
      parameterMap.set(deviceId, PT_VIRTUAL, 10024, 0)
    end
  end
end

--------------------------------------------------------------------------------
-- 3rd Wave Patch State Model
--
-- Compare model:
--   COMPARE_IT = 0 -> EDIT state (user-tweaked, mutable)
--   COMPARE_IT = 1 -> LOADED state (snapshot from last patch dump)
--
-- View model:
--   UI always shows: Single cache + currently selected Part cache
--   PART_NUMBER = 1 -> Part 1 overlay
--   PART_NUMBER = 2 -> Part 2 overlay
--
-- MIDI output:
--   parameterMap.onChange sends NRPN for voice params (<1024)
--   while repainting from cache, outgoing MIDI is suppressed via isApplyingCache
--------------------------------------------------------------------------------

-- Loaded snapshot from latest dump (immutable until next dump)
local singleBase, part1Base, part2Base = {}, {}, {}

-- Working edit state (starts as copy of Base, then updated on user edits)
local singleEdit, part1Edit, part2Edit = {}, {}, {}

-- Guard: true only while writing cached values into parameterMap
local isApplyingCache = false

--------------------------------------------------------------------------------
-- Utility / state helpers
--------------------------------------------------------------------------------

-- Copy one cache table (shallow copy: key/value pairs)
local function copyCache(src)
  local dst = {}
  for k, v in pairs(src) do
    dst[k] = v
  end
  return dst
end

-- Current visible part selector (1 or 2)
local function getPartSel()
  return parameterMap.get(deviceId, PT_VIRTUAL, PART_NUMBER) or 1
end

-- Compare mode flag:
-- false = Edit mode, true = Compare (Base) mode
local function getCompareMode()
  return (parameterMap.get(deviceId, PT_VIRTUAL, COMPARE_IT) or 0) == 1
end

-- True for synth voice params (as opposed to UI/meta controls)
local function isVoiceParam(pNum)
  return pNum < 1024
end

--------------------------------------------------------------------------------
-- SysEx decode helpers
--------------------------------------------------------------------------------

-- Extract patch name from first 32 tuples in cmd 0x02 patch dump.
-- Each tuple is [parMSB, parLSB, valMSB, valLSB], character in valLSB.
local function extractPatchName(sysexBlock)
  local chars = {}
  for i = 9, 136, 4 do
    local vLsb = sysexBlock:peek(i + 3) or 0
    if vLsb == 0 then break end
    chars[#chars + 1] = string.char(vLsb)
  end
  return table.concat(chars):gsub("%s+$", "")
end

-- Decode a tuple range into cache[parNum] = 14-bit value
local function decodeNrpnBlockToCache(sysexBlock, startByte, endByte, cache)
  local tupleCount = math.floor((endByte - startByte + 1) / 4)
  for t = 0, tupleCount - 1 do
    local i = startByte + t * 4
    local pMsb = sysexBlock:peek(i) or 0
    local pLsb = sysexBlock:peek(i + 1) or 0
    local vMsb = sysexBlock:peek(i + 2) or 0
    local vLsb = sysexBlock:peek(i + 3) or 0

    local parNum = pMsb * 128 + pLsb
    local value  = vMsb * 128 + vLsb
    cache[parNum] = value
  end
end

--------------------------------------------------------------------------------
-- Cache -> UI repaint helpers (no MIDI out)
--------------------------------------------------------------------------------

local function applyCacheToParams(cache, targetParType)
  targetParType = targetParType or PT_VIRTUAL
  for parNum, value in pairs(cache) do
    parameterMap.set(deviceId, targetParType, parNum, value)
  end
end

-- Repaint visible UI parameters from current mode + part selection.
-- Must not send MIDI; onChange is suppressed by isApplyingCache.
local function repaintFromVisibleCaches()
  if isApplyingCache then return end
  isApplyingCache = true

  local partSel = getPartSel()
  local isCompareMode = getCompareMode()

  -- Single layer always visible
  if isCompareMode then
    applyCacheToParams(singleBase, PT_VIRTUAL)
  else
    applyCacheToParams(singleEdit, PT_VIRTUAL)
  end

  -- Part overlay
  if partSel == 2 then
    if isCompareMode then
      applyCacheToParams(part2Base, PT_VIRTUAL)
    else
      applyCacheToParams(part2Edit, PT_VIRTUAL)
    end
  else
    if isCompareMode then
      applyCacheToParams(part1Base, PT_VIRTUAL)
    else
      applyCacheToParams(part1Edit, PT_VIRTUAL)
    end
  end

  isApplyingCache = false
end

--------------------------------------------------------------------------------
-- NRPN send helpers
--------------------------------------------------------------------------------

-- Map UI param number to synth NRPN number for selected part.
-- Part 2 uses +1000 offset plus special hole adjustments.
local function toSynthParNumForPart(parNum, partSel)
  if partSel == 2 then
    if parNum == 397 or parNum == 401 or parNum == 405 or parNum == 409 or parNum == 429 or parNum == 435 then
      parNum = parNum + 1
    end
    return parNum + 1000
  end
  return parNum
end

-- Send a full cache to synth on selected part/channel.
local function sendCacheToSynth(cache, partSel)
  local ch = (partSel == 2) and part2Channel or part1Channel
  for parNum, value in pairs(cache) do
    local outPar = toSynthParNumForPart(parNum, partSel)
    sendNRPN(ch, outPar, value)
  end
end

-- Push currently visible state to synth (used by Compare toggle).
local function resendVisibleToSynth()
  local partSel = getPartSel()
  local isCompareMode = getCompareMode()

  if isCompareMode then
    sendCacheToSynth(singleBase, partSel)
    if partSel == 2 then sendCacheToSynth(part2Base, partSel) else sendCacheToSynth(part1Base, partSel) end
  else
    sendCacheToSynth(singleEdit, partSel)
    if partSel == 2 then sendCacheToSynth(part2Edit, partSel) else sendCacheToSynth(part1Edit, partSel) end
  end
end

--------------------------------------------------------------------------------
-- Debug / validation helpers
--------------------------------------------------------------------------------

local function sortedKeys(t)
  local keys = {}
  if type(t) ~= "table" then return keys end
  for k, _ in pairs(t) do keys[#keys+1] = k end
  table.sort(keys)
  return keys
end

local function summarizeCache(name, cache)
  local keys = sortedKeys(cache)
  local n = #keys
  if n == 0 then
    print(name .. ": empty")
    return
  end

  local firstK, lastK = keys[1], keys[n]
  local firstV, lastV = cache[firstK], cache[lastK]

  print(string.format(
    "%s: count=%d first=(p%d v%d) last=(p%d v%d)",
    name, n, firstK, firstV, lastK, lastV
  ))
end

local function validateCaches()
  summarizeCache("singleBase", singleBase)
  summarizeCache("part1Base",  part1Base)
  summarizeCache("part2Base",  part2Base)
  summarizeCache("singleEdit", singleEdit)
  summarizeCache("part1Edit",  part1Edit)
  summarizeCache("part2Edit",  part2Edit)
end

--------------------------------------------------------------------------------
-- Name cleanup helper
--------------------------------------------------------------------------------

local function cleanPatchName(s)
  s = s:gsub("%z", "")
  s = s:gsub("%s+$", "")
  return s
end

--------------------------------------------------------------------------------
-- sysEx data received
--------------------------------------------------------------------------------

function midi.onSysex(midiInput, sysexBlock)
  local function is3rdWave()
    return sysexBlock:peek(1) == 0xF0 and sysexBlock:peek(2) == 0x00
       and sysexBlock:peek(3) == 0x02 and sysexBlock:peek(4) == 0x4A
       and sysexBlock:peek(5) == MODEL_BYTE
  end
  if not is3rdWave() then return end

  local cmd = sysexBlock:peek(6)
  local len = sysexBlock:getLength()
  print("3rd Wave sysex message received on interface= " .. midiInput.interface..", cmd=0x"..string.format("%02X",cmd).." len="..len)

  -- cmd 0x02 patch dump byte map:
  -- 9..136     patch name tuples (32)
  -- 137..672   single block A
  -- 673..1772  part 1 block
  -- 1773..1788 single block B
  -- 1789..2888 part 2 block
  if cmd == 0x02 then
    local bankNum = sysexBlock:peek(7)+1
    local progNum = sysexBlock:peek(8)
    print( "Patch data for bank ".. math.floor(bankNum)..", program " ..math.floor(progNum).." received" )

    local patchName = extractPatchName(sysexBlock)
    if patchName ~= "" then
      info.setText(string.sub(patchName, 1, 20))
    end

    -- Rebuild loaded snapshot
    singleBase, part1Base, part2Base = {}, {}, {}
    decodeNrpnBlockToCache(sysexBlock, 137, 672, singleBase)
    decodeNrpnBlockToCache(sysexBlock, 1773, 1788, singleBase)
    decodeNrpnBlockToCache(sysexBlock, 673, 1772, part1Base)
    decodeNrpnBlockToCache(sysexBlock, 1789, 2888, part2Base)

    -- Reset edit state from loaded snapshot
    singleEdit = copyCache(singleBase)
    part1Edit  = copyCache(part1Base)
    part2Edit  = copyCache(part2Base)

    validateCaches() -- optional debug
    repaintFromVisibleCaches()

  -- edit buffer data received (doesn't contain bank byte or program number byte)
  -- cmd 0x03 edit buffer dump byte map:
  -- 7..134     patch name tuples (32)
  -- 135..670   single block A
  -- 671..1770  part 1 block
  -- 1771..1786 single block B
  -- 1787..2886 part 2 block
-- elseif cmd == 0x03 then
--    print( "Current edit buffer data received" )

  elseif cmd == 0x11 then
    local bankNum = sysexBlock:peek(7)+1
    local progNum = sysexBlock:peek(8)+1
    local rawName = ""
    for i = 9, len-1 do
      rawName = rawName .. string.char(sysexBlock:peek(i))
    end
    print( "Name of bank ".. math.floor(bankNum).."  program " ..math.floor(progNum).." received: " .. rawName )
    nameBank[bankNum][progNum] = cleanPatchName(rawName)
    markNameBankDirty()

  elseif cmd == 0x04 and len == 11 then
    ppgNumber = sysexBlock:peek(7)
    userNumber = sysexBlock:peek(8)
    analogNumber = sysexBlock:peek(9)
    sampleNumber = sysexBlock:peek(10)
    print( "There are "..math.floor(ppgNumber).." PPG, "..math.floor(userNumber).." User, "..math.floor(analogNumber)..
          " Analog, and "..math.floor(sampleNumber).." Sample wavetables loaded" )
  end
end

--------------------------------------------------------------------------------
-- Program change message recieved (Synth -> UI)
--------------------------------------------------------------------------------
-- External program change on synth: mirror program index.
-- Only updates virtual program-number parameter value. 
-- Does not call a program sysEx dump - use select buttons
function midi.onProgramChange(midiInput, channel, progNum)
  parameterMap.set(deviceId, PT_VIRTUAL, PROG_NUMBER, progNum)
  local bankNum = parameterMap.get (deviceId, PT_VIRTUAL, BANK_NUMBER)
end

--------------------------------------------------------------------------------
-- Bank MSB CC7 message recieved (Synth -> UI)
--------------------------------------------------------------------------------
-- only updates bankNum virtual parameter value 
function midi.onControlChange(midiInput, ch, controllerNumber, value)
  if controllerNumber == 32 then
    parameterMap.set(deviceId, PT_VIRTUAL, BANK_NUMBER, value)
  end
end

--------------------------------------------------------------------------------
-- Parameter change callback (UI -> synth and cache)
--------------------------------------------------------------------------------

function parameterMap.onChange(valueObjects, origin, midiValue)
  if (origin ~= INTERNAL) then return end

  local msg = valueObjects[1]:getMessage()
  local pNum = msg:getParameterNumber()
  local pType = msg:getType()

  -- UI/meta controls first (no direct NRPN for these)
  if pType == PT_VIRTUAL and pNum == PART_NUMBER then
    repaintFromVisibleCaches()
    return
  end

  if pType == PT_VIRTUAL and pNum == COMPARE_IT then
    repaintFromVisibleCaches()
    resendVisibleToSynth() -- comment out for visual-only compare
    return
  end

  -- Suppress outgoing actions while repainting cache into parameterMap
  if isApplyingCache then return end

  -- Voice parameter edits -> update edit cache + send NRPN
  if pType == PT_VIRTUAL and isVoiceParam(pNum) then
    local uiPar = pNum
    local outPar = pNum
    local partNum = getPartSel()
    local ch = part1Channel

    if partNum == 2 then
      ch = part2Channel
      outPar = toSynthParNumForPart(outPar, 2)
    end

    -- In edit mode, persist local tweak into edit cache
    if not getCompareMode() then
      if singleEdit[uiPar] ~= nil then
        singleEdit[uiPar] = midiValue
      end

      if partNum == 2 then
        part2Edit[uiPar] = midiValue
      else
        part1Edit[uiPar] = midiValue
      end
    end

    sendNRPN(ch, outPar, midiValue)
  end
end
