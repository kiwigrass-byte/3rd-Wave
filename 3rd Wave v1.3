end

-- format master output Pan
function pan(valueObject,value)
  local control = valueObject:getControl():getId()
  local side =" L"
  if (value < 0 ) then 
    controls.get(control):setColor (BLUE)
  elseif (value == 0) then
    side = " Center"
    controls.get(control):setColor (WHITE)
  elseif (value > 0) then
    side = " R"
    controls.get(control):setColor (RED)
  end
  return(value)
end

