-- 3rd Wave 8M v1.6 envelope editor (wave-only, env target 1..3)
-- Standalone first-pass with NRPN transmit

assert(
    controller.isRequired(MODEL_MK2, "4.1.4"),
    "Version 4.1.4 or higher is required"
)

local DEBUG = true

local function dprint(msg)
   if DEBUG then print(msg) end
end

portNum = PORT_1
port = portNum
midiCh = 1 -- if needed, try 0 for 0-based environments

-- hide or show loop guides
local SHOW_LOOP_GUIDES = false

-- ---------- Envelope model ----------
WAVEPTS = 6
NUMPTS  = WAVEPTS

TIME_MIN = 0
TIME_MAX = 127
LEVEL_MIN = 0
LEVEL_MAX = 63

LOW_MIDI = 0
HI_MIDI  = 127

WIN_OFST = 70
SUSTAIN  = 64
SCALEX   = 0.90625
SCALEY   = 3


AX  = 1
AY  = 2
CLR = 3

-- ---------- Colors ----------
local STD_COLOR = 0xB0C0
local ACT_COLOR = 0xFF0000
local ON_COLOR  = 0x0000FF

-- ---------- Virtual parameter numbers ----------
-- All are virtual in your setup
local UI_STAGE_SELECT = 5008
local UI_TIME_EDIT    = 5009
local UI_LEVEL_EDIT   = 5010
local UI_ENV_TARGET   = 5011   -- envelope target selector: 1..3

-- ---------- Synth NRPN base numbers (env1) ----------
local STAGE_TIME_NRPN  = {134, 137, 140, 143, 146, 149}
local STAGE_LEVEL_NRPN = {265, 268, 271, 274, 277, 280}

local LOOP_STATE_NRPN_BASE = 234
local LOOP_START_NRPN_BASE = 155
local LOOP_END_NRPN_BASE   = 152

-- ---------- Geometry ----------
local DRAW_H = 220
local XY_PAD_WIDTH  = math.floor((128 * SCALEX * WAVEPTS) + SUSTAIN + 0.5)
local XY_PAD_HEIGHT = math.floor(DRAW_H + WIN_OFST + 0.5)

-- ---------- Runtime state ----------
activePt = 1

-- target synth envelope 1..3
local targetEnv = 1
local envOffset = 0 -- targetEnv - 1

local waveEnv = {}
waveEnv[0] = {TIME_MIN, LEVEL_MIN, STD_COLOR}
waveEnv[WAVEPTS+1] = {TIME_MAX, LEVEL_MAX, STD_COLOR}

local defaultP = {48, 1, 48, 1, 48, 1}
for i=1,WAVEPTS do
   waveEnv[i] = {TIME_MAX, defaultP[i] or 0, STD_COLOR}
end
waveEnv[activePt][CLR] = ACT_COLOR

-- single loop only: [startSeg, endSeg, enabled, color]
envLoop = {}
envLoop[1] = {1, 6, false, ON_COLOR}

local g = graphics
local xyPadControl = controls.get(4)
xyPadControl.x = 0
xyPadControl.y = 0

local function clamp(v, lo, hi)
   return math.max(lo, math.min(hi, v))
end

function sendNRPN(ch, nrpn, value)
  midi.sendControlChange(port, ch, 99, math.floor(nrpn / 128))
  midi.sendControlChange(port, ch, 98, nrpn % 128)
  midi.sendControlChange(port, ch, 6,  math.floor(value / 128))
  midi.sendControlChange(port, ch, 38, value % 128)
end

local function txStageTime(stage, value)
   local nrpn = STAGE_TIME_NRPN[stage] + envOffset
   local v = clamp(value, TIME_MIN, TIME_MAX)
   sendNRPN(midiCh, nrpn, v)
   dprint(string.format("NRPN TX env=%d stage=%d TIME nrpn=%d val=%d", targetEnv, stage, nrpn, v))
end

local function txStageLevel(stage, value)
   local nrpn = STAGE_LEVEL_NRPN[stage] + envOffset
   local v = clamp(value, LEVEL_MIN, LEVEL_MAX)
   sendNRPN(midiCh, nrpn, v)
   dprint(string.format("NRPN TX env=%d stage=%d LEVEL nrpn=%d val=%d", targetEnv, stage, nrpn, v))
end

local function txLoopState(isOn)
   local nrpn = LOOP_STATE_NRPN_BASE + envOffset
   local v = isOn and 1 or 0
   sendNRPN(midiCh, nrpn, v)
   dprint(string.format("NRPN TX env=%d LOOP_STATE nrpn=%d val=%d", targetEnv, nrpn, v))
end

local function txLoopStart(v)
   local nrpn = LOOP_START_NRPN_BASE + envOffset
   local val = clamp(v, 1, WAVEPTS)
   sendNRPN(midiCh, nrpn, val)
   dprint(string.format("NRPN TX env=%d LOOP_START nrpn=%d val=%d", targetEnv, nrpn, val))
end

local function txLoopEnd(v)
   local nrpn = LOOP_END_NRPN_BASE + envOffset
   local val = clamp(v, 1, WAVEPTS)
   sendNRPN(midiCh, nrpn, val)
   dprint(string.format("NRPN TX env=%d LOOP_END nrpn=%d val=%d", targetEnv, nrpn, val))
end

function preset.onLoad()
    local bounds = xyPadControl:getBounds()
    bounds[WIDTH]  = math.floor(XY_PAD_WIDTH + 0.5)
    bounds[HEIGHT] = math.floor(XY_PAD_HEIGHT + 0.5)
    xyPadControl:setBounds(bounds)

    xyPadControl:setPaintCallback(paintXyPad)
    xyPadControl:setTouchCallback(touchCallback)

    -- Stage selector control range (control 5 in your current layout)
    local ctlId = controls.get(5)
    local valId = ctlId:getValue("value")
    valId:setRange(1, NUMPTS, 1, true)

    -- Single-loop control colors
    local c = controls.get(1); if c ~= nil then c:setColor(ON_COLOR) end
    c = controls.get(8); if c ~= nil then c:setColor(ON_COLOR) end
    c = controls.get(9); if c ~= nil then c:setColor(ON_COLOR) end

    -- Do NOT hide control 3 (you are using it for env target now)
end

function printValues()
   local fs = 10           -- font size (was 10)
   local dx = 110           -- horizontal spacing (was 110)

   for i=1,NUMPTS do
      g.setColor(waveEnv[i][CLR])
      g.print(i*dx,  0, string.format("T%d: %d ", i, waveEnv[i][AX]), fs, LEFT)
      g.print(i*dx, 18, string.format("P%d: %d ", i, waveEnv[i][AY]), fs, LEFT)
   end

   g.setColor(STD_COLOR)
   g.print(5, 42, string.format("Target Env: %d", targetEnv), 11, LEFT)
end

