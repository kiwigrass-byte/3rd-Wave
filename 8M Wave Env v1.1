function loopCalc(loop)
   local st = 0
   for i=1,envLoop[loop][1] do st = st + waveEnv[i][AX] end
   st = math.floor(st * SCALEX)

   local sz = 0
   for i=envLoop[loop][1]+1,envLoop[loop][2]+1 do sz = sz + waveEnv[i][AX] end
   sz = math.floor(sz * SCALEX)
   return st, sz
end

function paintXyPad(control, value)

   local bounds = control:getBounds()
   g.setColor(0x0000)
   g.fillRect(0, 0, bounds[WIDTH], bounds[HEIGHT])

   g.setColor(STD_COLOR)
   g.drawRect(0, WIN_OFST, bounds[WIDTH], bounds[HEIGHT]-WIN_OFST)

   local strt, lnth = loopCalc(1)
   g.setColor(envLoop[1][4])
   if SHOW_LOOP_GUIDES then
      if (envLoop[1][3] == true) then
         g.fillRect(strt, 35, lnth, 10)
      else
         local keyRel = 0
         for j=1,envLoop[1][2]-1 do keyRel = keyRel + waveEnv[j][AX] end
         keyRel = math.floor(keyRel * SCALEX) + SUSTAIN
         g.fillRect(keyRel-5, 35, 10, 10)
      end
   end

   local xPos = 0
   local yPos = XY_PAD_HEIGHT
   for i=1,NUMPTS do
      local xScale = math.floor(waveEnv[i][AX] * SCALEX)
      local yScale = waveEnv[i][AY] * SCALEY
--      local ym1Scale = (i > 1) and (waveEnv[i-1][AY] * SCALEY) or yScale
      local ym1Scale = ((i > 1) and waveEnv[i-1][AY] or waveEnv[0][AY]) * SCALEY

      g.setColor(waveEnv[i][CLR])
      g.fillCircle(xPos + xScale, yPos - yScale, 10)

      g.setColor(STD_COLOR)
      g.drawLine(xPos, yPos - ym1Scale, xPos + xScale, yPos - yScale)

      xPos = xPos + xScale

      if SHOW_LOOP_GUIDES then
         if (i == envLoop[1][2]-1) and (envLoop[1][3] == false) then
            g.drawLine(xPos, yPos - yScale, xPos + SUSTAIN, yPos - yScale)
            xPos = xPos + SUSTAIN
         end
      end
   end

   printValues()
end

function touchCallback(control, touchEvent)
   local endPt = NUMPTS + 1
   local tolerance = 25

   if touchEvent.type == MOVE then
      if (touchEvent.y < WIN_OFST) then return end

      local preX = 0
      for i=1,activePt-1 do preX = preX + waveEnv[i][AX] end

      local postX = preX + waveEnv[activePt][AX]
      if (activePt ~= endPt) then postX = postX + waveEnv[activePt+1][AX] end

      if (activePt ~= endPt) and (touchEvent.x >= preX) and (touchEvent.x <= postX) then
         control.x = touchEvent.x
         control.y = touchEvent.y

         local t = clamp(math.floor((control.x - preX) / SCALEX), TIME_MIN, TIME_MAX)
         local l = clamp(math.floor((XY_PAD_HEIGHT - control.y) / SCALEY), LEVEL_MIN, LEVEL_MAX)
         waveEnv[activePt][AX] = t
         waveEnv[activePt][AY] = l

         parameterMap.set(1, PT_VIRTUAL, UI_TIME_EDIT, t)
         parameterMap.set(1, PT_VIRTUAL, UI_LEVEL_EDIT, l)
      end

   elseif touchEvent.type == DOWN then
      local i = 1
      local xPos = 0
      local yPos = XY_PAD_HEIGHT

      if (touchEvent.y >= WIN_OFST) then
         local minDist = math.huge
         local closestPt = endPt

         while (i < endPt) do
            local xScale = math.floor(waveEnv[i][AX] * SCALEX)
            if (envLoop[1][3] == false) and (i == envLoop[1][2]) then
               xScale = xScale + SUSTAIN
            end
            local yScale = waveEnv[i][AY] * SCALEY

            local dist = math.sqrt((touchEvent.x - (xPos + xScale))^2 + (touchEvent.y - (yPos - yScale))^2)
            if dist < minDist then
               minDist = dist
               closestPt = i
            end

            xPos = xPos + xScale
            i = i + 1
         end

         if minDist <= tolerance then i = closestPt else i = endPt end
      else
         i = endPt
      end

      if (activePt ~= endPt) then waveEnv[activePt][CLR] = STD_COLOR end
      if (i ~= endPt) then waveEnv[i][CLR] = ACT_COLOR end

      activePt = i
      parameterMap.set(1, PT_VIRTUAL, UI_STAGE_SELECT, math.min(activePt, endPt))
   end

   control:repaint()
end

function parameterMap.onChange(valueObjects, origin, midiValue)
  if (origin == MIDI) then return end

  local msg = valueObjects[1]:getMessage()
  local pNum = msg:getParameterNumber()
  local pType = msg:getType()

  if pType == PT_VIRTUAL and pNum < 5000 then
   sendNRPN(midiCh, pNum, midiValue)
  end

   -- Only handle our known UI virtual params
   if (origin == LUA)
      and (pNum ~= UI_TIME_EDIT)
      and (pNum ~= UI_LEVEL_EDIT)
      and (pNum ~= UI_STAGE_SELECT)
      and (pNum ~= UI_ENV_TARGET) then
      return
   end

   -- stage time edit -> synth
   if (pNum == UI_TIME_EDIT) then
      if activePt >= 1 and activePt <= WAVEPTS then
         txStageTime(activePt, midiValue)
      end
      return
   end

   -- stage level edit -> synth
   if (pNum == UI_LEVEL_EDIT) then
      if activePt >= 1 and activePt <= WAVEPTS then
         txStageLevel(activePt, midiValue)
      end
      return
   end
end

function dispDot(valueObject, value)
   if (activePt == NUMPTS+1) then return "None" end
   return math.floor(activePt)
end

function dispX(valueObject, value)
   if (activePt == NUMPTS+1) then return " ? " end
   return math.floor(waveEnv[activePt][AX])
end

function dispY(valueObject, value)
   if (activePt == NUMPTS+1) then return " ? " end
   return math.floor(waveEnv[activePt][AY])
end

function adjustTime(valueObject, value)
   if (activePt ~= NUMPTS+1) then
      local t = clamp(value, TIME_MIN, TIME_MAX)
      waveEnv[activePt][AX] = t
      parameterMap.set(1, PT_VIRTUAL, UI_TIME_EDIT, t)
      xyPadControl:repaint()
   end
end

function adjustLevel(valueObject, value)
   if (activePt ~= NUMPTS+1) then
      local l = clamp(value, LEVEL_MIN, LEVEL_MAX)
      waveEnv[activePt][AY] = l
      parameterMap.set(1, PT_VIRTUAL, UI_LEVEL_EDIT, l)
      xyPadControl:repaint()
   end
end

function selectStage(valueObject, value)
   waveEnv[activePt][CLR] = STD_COLOR
   activePt = clamp(math.floor(value), 1, NUMPTS)
   waveEnv[activePt][CLR] = ACT_COLOR

   parameterMap.set(1, PT_VIRTUAL, UI_TIME_EDIT,  waveEnv[activePt][AX])
   parameterMap.set(1, PT_VIRTUAL, UI_LEVEL_EDIT, waveEnv[activePt][AY])

   xyPadControl:repaint()
end

local UI_ENV_EDIT_1 = 45
local UI_ENV_EDIT_2 = 46
local UI_ENV_EDIT_3 = 47

local function txSynthEnvEditFocus(envNum)
   local v1 = (envNum == 1) and 1 or 0
   local v2 = (envNum == 2) and 1 or 0
   local v3 = (envNum == 3) and 1 or 0

   sendNRPN(midiCh, UI_ENV_EDIT_1, v1)
   sendNRPN(midiCh, UI_ENV_EDIT_2, v2)
   sendNRPN(midiCh, UI_ENV_EDIT_3, v3)

   dprint(string.format("NRPN TX envFocus env=%d -> [45]=%d [46]=%d [47]=%d", envNum, v1, v2, v3))
end

-- bind your env-target selector control callback to this (values 1..3)
function selectTargetEnvelope(valueObject, value)
   local raw = math.floor(value)
   if raw >= 0 and raw <= 2 then raw = raw + 1 end -- list-control normalization

   targetEnv = clamp(raw, 1, 3)
   envOffset = targetEnv - 1

   txSynthEnvEditFocus(targetEnv)

   dprint(string.format("Target envelope set: target=%d offset=%d", targetEnv, envOffset))
   xyPadControl:repaint()
end

-- Single-loop handlers (controls for loop state/start/end)
function setState(valueObject, value)
   envLoop[1][3] = (value == 1)
   txLoopState(envLoop[1][3])
   xyPadControl:repaint()
end

function setStart(valueObject, value)
   envLoop[1][1] = clamp(value, 1, WAVEPTS)
   if (envLoop[1][2] < envLoop[1][1]) then envLoop[1][2] = envLoop[1][1] end
   txLoopStart(envLoop[1][1])
   xyPadControl:repaint()
end

function setEnd(valueObject, value)
   envLoop[1][2] = clamp(value, envLoop[1][1], WAVEPTS)
   txLoopEnd(envLoop[1][2])
   xyPadControl:repaint()
end
