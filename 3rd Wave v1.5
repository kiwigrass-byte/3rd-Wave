-- helper function to concatenate two arrays. Used for SysEx message construction
local function concat(t1, t2)
  local t = {}
  for i=1,#t1 do t[#t+1] = t1[i] end
  for i=1,#t2 do t[#t+1] = t2[i] end
  return t
end

