function selectWavetable(valueObject, value)
  local waveType = parameterMap.get(deviceId, PT_VIRTUAL, WAVE_TYPE_PARAM)
  local nrpnValue
  
  if waveType == 0 then nrpnValue = value  -- P (0-35)
  elseif waveType == 1 then nrpnValue = 128 + value  -- U (128-183)
